ANYKERNEL_SOURCE=https://github.com/grepfox/anykernel3
ANYKERNEL_SOURCE_BRANCH=cepheus
KERNEL_SOURCE=https://github.com/crdroidandroid/android_kernel_xiaomi_sm8150
KERNEL_SOURCE_BRANCH=16.0
